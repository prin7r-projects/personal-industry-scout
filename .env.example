# Public app URL used in NOWPayments redirects + IPN callback URLs.
NEXT_PUBLIC_APP_URL=https://personal-industry-scout.prin7r.com
NEXT_PUBLIC_SITE_URL=https://personal-industry-scout.prin7r.com

# NOWPayments hosted invoice + IPN.
# Live keys live only in the deploy host's /opt/prin7r-deploys/personal-industry-scout/.env
# Reference values are documented in /Users/keer/.nth-kir-keys.env (private).
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=false

# (Forward-compat; not used by Wave 2 landing) WalletConnect / Reown project.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Postgres connection string for Prisma.
DATABASE_URL=postgresql://pis:pis_dev@localhost:5432/pis

# Notion integration token (Phase 1 transitional).
NOTION_TOKEN=
NOTION_BRIEFS_DATABASE_ID=

# Postmark server token for transactional email.
POSTMARK_SERVER_TOKEN=

# Backblaze B2 credentials for PDF artifact storage.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET_NAME=prin7r-pis-pdfs

# Telegram bot token (Phase 3 forward-compat).
TELEGRAM_BOT_TOKEN=

# Intake token signing secret.
INTAKE_TOKEN_SECRET=

# (Forward-compat; not used by Wave 2 landing) Merchant settlement wallets.
MERCHANT_USDT_TRC20_ADDRESS=
MERCHANT_USDT_ERC20_ADDRESS=
MERCHANT_USDC_ERC20_ADDRESS=
MERCHANT_USDC_POLYGON_ADDRESS=
MERCHANT_USDT_BSC_ADDRESS=

# (Forward-compat; not used by Wave 2 landing) Plisio direct stablecoin.
PLISIO_API_KEY=
