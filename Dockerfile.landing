# Multistage build for Next.js 15 standalone landing (pnpm monorepo)
FROM node:22-alpine AS deps
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/db/package.json packages/db/
COPY packages/postmark/package.json packages/postmark/
COPY packages/role-gate/package.json packages/role-gate/
COPY apps/landing/package.json apps/landing/

RUN pnpm install --frozen-lockfile

FROM node:22-alpine AS builder
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

COPY --from=deps /app ./
COPY packages/ packages/
COPY apps/landing/ apps/landing/

ENV NEXT_TELEMETRY_DISABLED=1
RUN cd packages/db && npx prisma generate
RUN cd apps/landing && npx next build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=3000 \
    NEXT_TELEMETRY_DISABLED=1
RUN addgroup -g 1001 -S nodejs && adduser -S nextjs -u 1001
COPY --from=builder /app/apps/landing/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/apps/landing/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/landing/.next/static ./.next/static
USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
