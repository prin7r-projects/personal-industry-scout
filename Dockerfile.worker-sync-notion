# Worker: sync_notion — pulls briefs from Notion into Postgres.
# Triggered via cron on the host: docker compose --profile workers run --rm worker-sync-notion

FROM node:22-alpine

WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

# Copy workspace config
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/db/package.json packages/db/
COPY worker/sync_notion/package.json worker/sync_notion/

# Install dependencies
RUN pnpm install --frozen-lockfile --prod

# Copy source
COPY packages/db/ packages/db/
COPY worker/sync_notion/ worker/sync_notion/

# Generate Prisma client
RUN cd packages/db && npx prisma generate

ENTRYPOINT ["pnpm", "--filter", "@pis/worker-sync-notion", "sync"]
