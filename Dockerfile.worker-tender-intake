# Worker: tender_intake — pulls open tenders from RSS/JSON sources into Postgres.
# Triggered via cron on the host: docker compose --profile workers run --rm worker-tender-intake

FROM node:24-alpine

WORKDIR /app

ENV NODE_ENV=production

# Install pnpm
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

# Copy workspace config
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/db/package.json packages/db/
COPY worker/tender_intake/package.json worker/tender_intake/

# Install dependencies
RUN pnpm install --frozen-lockfile --prod

# Copy source
COPY packages/db/ packages/db/
COPY worker/tender_intake/ worker/tender_intake/

# Generate Prisma client
RUN cd packages/db && npx prisma generate

ENTRYPOINT ["pnpm", "--filter", "@pis/worker-tender-intake", "intake"]
