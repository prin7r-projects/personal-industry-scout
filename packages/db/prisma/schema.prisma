generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  passwordHash    String?
  name            String?
  emailVerified   Boolean          @default(false)
  image           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  accounts        Account[]
  sessions        Session[]
  verifications   Verification[]
  watches         Watch[]
  matches         Match[]
  bots            Bot[]
  scouts          Scout[]
  briefs          Brief[]
  webhookConfigs  WebhookConfig[]
  campaigns       Campaign[]
  ownedWorkspaces Workspace[]
  assets          Asset[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id        String   @id @default(cuid())
  identifier String
  value     String
  expires   DateTime
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([identifier, value])
}

model Tender {
  id          String   @id @default(cuid())
  title       String
  description String
  buyer       String
  value       Float?
  currency    String   @default("GBP")
  status      String   @default("open")
  deadline    DateTime?
  sourceUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  watches     Watch[]
  matches     Match[]
}

model Watch {
  id        String   @id @default(cuid())
  userId    String
  tenderId  String
  keywords  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tender    Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@unique([userId, tenderId])
}

model Match {
  id        String   @id @default(cuid())
  userId    String
  tenderId  String
  score     Float    @default(0)
  reason    String?
  seen      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tender    Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@unique([userId, tenderId])
}

model Tool {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  category  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Template {
  id        String   @id @default(cuid())
  industry  String   @unique
  name      String
  slug      String   @unique
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bot {
  id            String   @id @default(cuid())
  name          String
  systemPrompt  String   @default("")
  businessHours String   @default("")
  greeting      String   @default("")
  fallback      String   @default("")
  brandColor    String   @default("#4F46E5")
  userId        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Scout {
  id        String   @id @default(cuid())
  userId    String
  industry  String
  region    String
  signals   String   @default("[]")
  twilioSid String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Brief {
  id        String   @id @default(cuid())
  topic     String
  audience  String
  weekOf    String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Campaign {
  id        String   @id @default(cuid())
  name      String
  userId    String
  sent      Int      @default(0)
  replies   Int      @default(0)
  opens     Int      @default(0)
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  assets    Asset[]

  @@index([ownerId])
}

model Asset {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  name        String
  type        String
  url         String
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
}

model WebhookConfig {
  id        String   @id @default(cuid())
  userId    String
  label     String
  url       String
  secret    String
  events    String   @default("[]")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id             String        @id @default(cuid())
  webhookConfigId String
  eventType      String
  status         String        @default("pending")
  attempt        Int           @default(0)
  maxAttempts    Int           @default(5)
  nextRetryAt    DateTime?
  payload        String        @default("{}")
  attemptLog     String        @default("[]")
  responseStatus Int?
  responseBody   String?
  error          String?
  durationMs     Int?
  lastAttemptAt  DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  webhookConfig  WebhookConfig @relation(fields: [webhookConfigId], references: [id], onDelete: Cascade)
}
