# Worker: scout_signals — fetches industry signals via Brave Search API.
# Triggered via cron on the host: docker compose --profile workers run --rm -e SCOUT_ID=<uuid> worker-scout-signals

FROM node:24-alpine

WORKDIR /app

ENV NODE_ENV=production

# Install pnpm
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

# Copy workspace config
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/db/package.json packages/db/
COPY worker/scout_signals/package.json worker/scout_signals/

# Install dependencies
RUN pnpm install --frozen-lockfile --prod

# Copy source
COPY packages/db/ packages/db/
COPY worker/scout_signals/ worker/scout_signals/

# Generate Prisma client
RUN cd packages/db && npx prisma generate

ENTRYPOINT ["pnpm", "--filter", "@pis/worker-scout-signals", "scout-signals"]
